---
// src/components/Header.astro
import BrandMark from "./BrandMark.astro";
import Button from "./Button.astro";
import { navLinks, brand } from "../config/brand";

const currentPath = Astro.url.pathname;
const isDiscoveryCallExternal = brand.discoveryCallUrl.startsWith("http");
const isActiveLink = (href: string) =>
  currentPath === href ||
  (href === "/3stone-one" && currentPath === "/3stone-one") ||
  (href === "/products" && currentPath === "/portfolio");
const isProductPath =
  currentPath === "/products" ||
  currentPath === "/portfolio" ||
  currentPath === "/3stone-one" ||
  currentPath === "/3stone-picks";
const isSolutionPath =
  currentPath === "/services" || currentPath.startsWith("/3stone-one/build-your-stack");
const isCompanyPath = currentPath === "/about" || currentPath === "/contact";
---

<header class="site-header">
  <div class="container site-header-inner">
    <BrandMark size="md" />

    <nav class="site-nav" aria-label="Primary">
      <ul class="desktop-nav-list">
        <li><a href="/" aria-current={currentPath === "/" ? "page" : undefined}>Home</a></li>
        <li>
          <details class="nav-dropdown">
            <summary class:list={{ active: isProductPath }}>
              Products
              <svg aria-hidden="true" viewBox="0 0 12 12"><path d="m3 4.5 3 3 3-3" /></svg>
            </summary>
            <div class="dropdown-panel">
              <a href="/products" aria-current={currentPath === "/products" ? "page" : undefined}>
                <span>All Products</span>
                <small>Explore the full 3Stone AI portfolio</small>
              </a>
              <a href="/3stone-one" aria-current={currentPath === "/3stone-one" ? "page" : undefined}>
                <span>3Stone One</span>
                <small>AI-powered business operations</small>
              </a>
              <a href="/3stone-picks" aria-current={currentPath === "/3stone-picks" ? "page" : undefined}>
                <span>3Stone Picks</span>
                <small>Sports intelligence, formerly BetAI</small>
              </a>
              <a href="/products">
                <span>3Stone Counsel <span class="dropdown-badge">Coming Soon</span></span>
                <small>Self-guided legal &amp; financial prep</small>
              </a>
            </div>
          </details>
        </li>
        <li>
          <details class="nav-dropdown">
            <summary class:list={{ active: isSolutionPath }}>
              Solutions
              <svg aria-hidden="true" viewBox="0 0 12 12"><path d="m3 4.5 3 3 3-3" /></svg>
            </summary>
            <div class="dropdown-panel compact">
              <a href="/services"><span>Services</span><small>Custom software and automation</small></a>
              <a href="/3stone-one/build-your-stack"><span>Build Your Stack</span><small>Compare tools and estimate pricing</small></a>
            </div>
          </details>
        </li>
        <li>
          <details class="nav-dropdown">
            <summary class:list={{ active: isCompanyPath }}>
              Company
              <svg aria-hidden="true" viewBox="0 0 12 12"><path d="m3 4.5 3 3 3-3" /></svg>
            </summary>
            <div class="dropdown-panel compact">
              <a href="/about"><span>About</span><small>Why 3Stone AI exists</small></a>
              <a href="/contact"><span>Contact</span><small>Start a conversation</small></a>
            </div>
          </details>
        </li>
      </ul>
    </nav>

    <div class="site-header-cta">
      <details class="nav-dropdown account-dropdown">
        <summary>
          Account
          <svg aria-hidden="true" viewBox="0 0 12 12"><path d="m3 4.5 3 3 3-3" /></svg>
        </summary>
        <div class="dropdown-panel compact dropdown-right">
          <a href={brand.adminWorkspaceLoginUrl} target="_blank" rel="noopener noreferrer">
            <span>Admin Portal</span><small>3Stone AI staff access</small>
          </a>
        </div>
      </details>
      <Button href={brand.discoveryCallUrl} variant="primary">Book a Call</Button>
    </div>

    <button
      class="mobile-nav-toggle"
      aria-expanded="false"
      aria-controls="mobile-nav"
      aria-label="Open menu"
      id="mobile-nav-toggle"
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <line x1="3" y1="6" x2="21" y2="6" />
        <line x1="3" y1="12" x2="21" y2="12" />
        <line x1="3" y1="18" x2="21" y2="18" />
      </svg>
    </button>
  </div>

  <nav id="mobile-nav" class="mobile-nav" aria-label="Mobile" hidden>
    <ul>
      {navLinks.map((link) => (
        <li>
          <a href={link.href} aria-current={isActiveLink(link.href) ? "page" : undefined}>
            {link.label}
          </a>
        </li>
      ))}
      <li>
        <a href={brand.adminWorkspaceLoginUrl} target="_blank" rel="noopener noreferrer" class="mobile-nav-admin-link">
          Admin Login
        </a>
      </li>
      <li>
        <a
          href={brand.discoveryCallUrl}
          class="mobile-nav-cta"
          target={isDiscoveryCallExternal ? "_blank" : undefined}
          rel={isDiscoveryCallExternal ? "noopener noreferrer" : undefined}
        >
          Book a Discovery Call
        </a>
      </li>
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById("mobile-nav-toggle");
  const menu = document.getElementById("mobile-nav");
  const dropdowns = Array.from(document.querySelectorAll<HTMLDetailsElement>(".nav-dropdown"));

  toggle?.addEventListener("click", () => {
    const isOpen = menu?.hasAttribute("hidden") === false;
    if (isOpen) {
      menu?.setAttribute("hidden", "");
      toggle.setAttribute("aria-expanded", "false");
    } else {
      menu?.removeAttribute("hidden");
      toggle.setAttribute("aria-expanded", "true");
    }
  });

  dropdowns.forEach((dropdown) => {
    dropdown.addEventListener("toggle", () => {
      if (!dropdown.open) return;
      dropdowns.forEach((other) => {
        if (other !== dropdown) other.removeAttribute("open");
      });
    });
  });

  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Element) || event.target.closest(".nav-dropdown")) return;
    dropdowns.forEach((dropdown) => dropdown.removeAttribute("open"));
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      dropdowns.forEach((dropdown) => dropdown.removeAttribute("open"));
    }
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(5, 5, 5, 0.85);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border-subtle);
  }

  .site-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding-top: var(--space-md);
    padding-bottom: var(--space-md);
  }

  .site-header-cta {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .mobile-nav-admin-link {
    color: var(--text-tertiary) !important;
    font-size: 14px !important;
  }

  .desktop-nav-list {
    display: flex;
    align-items: center;
    gap: 8px;
    list-style: none;
    margin: 0;
    padding: 0;
    white-space: nowrap;
  }

  .site-nav > ul > li > a,
  .nav-dropdown > summary {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 9px 10px;
    text-decoration: none;
    color: var(--text-secondary);
    font-size: 14px;
    font-weight: 500;
    transition: color 0.15s ease;
    cursor: pointer;
    list-style: none;
  }

  .nav-dropdown > summary::-webkit-details-marker {
    display: none;
  }

  .nav-dropdown > summary svg {
    width: 12px;
    height: 12px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    transition: transform 0.15s ease;
  }

  .nav-dropdown[open] > summary svg {
    transform: rotate(180deg);
  }

  .site-nav > ul > li > a:hover,
  .nav-dropdown > summary:hover,
  .nav-dropdown > summary.active,
  .nav-dropdown[open] > summary {
    color: var(--text-primary);
  }

  .site-nav > ul > li > a[aria-current="page"],
  .nav-dropdown > summary.active {
    color: var(--accent-primary);
  }

  .nav-dropdown {
    position: relative;
  }

  .dropdown-panel {
    position: absolute;
    top: calc(100% + 10px);
    left: 0;
    z-index: 80;
    display: grid;
    width: 300px;
    padding: 8px;
    background: rgba(12, 12, 13, 0.98);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    box-shadow: 0 22px 60px rgba(0, 0, 0, 0.42);
  }

  .dropdown-panel.compact {
    width: 270px;
  }

  .dropdown-right {
    right: 0;
    left: auto;
  }

  .dropdown-panel a {
    display: grid;
    gap: 3px;
    padding: 12px;
    color: var(--text-primary);
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition: background-color 0.15s ease;
  }

  .dropdown-panel a:hover {
    background: rgba(255, 255, 255, 0.05);
  }

  .dropdown-panel a[aria-current="page"] {
    background: var(--accent-primary-dim);
  }

  .dropdown-panel span {
    font-size: 14px;
    font-weight: 600;
  }

  .dropdown-badge {
    display: inline-block;
    margin-left: 4px;
    padding: 2px 7px;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.3px;
    color: var(--text-tertiary);
    background: var(--bg-surface-raised);
    border: 1px solid var(--border-subtle);
    border-radius: 999px;
    vertical-align: middle;
  }

  .dropdown-panel small {
    color: var(--text-tertiary);
    font-size: 12px;
    line-height: 1.4;
    white-space: normal;
  }

  .mobile-nav-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background: transparent;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    color: var(--text-primary);
    padding: 0;
    cursor: pointer;
  }

  .mobile-nav {
    border-top: 1px solid var(--border-subtle);
    background: var(--bg-surface);
  }

  .mobile-nav ul {
    list-style: none;
    margin: 0;
    padding: var(--space-md) var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .mobile-nav a {
    text-decoration: none;
    color: var(--text-secondary);
    font-size: 15px;
  }

  .mobile-nav a[aria-current="page"] {
    color: var(--accent-primary);
  }

  .mobile-nav-cta {
    color: var(--accent-primary) !important;
    font-weight: 600;
  }

  @media (max-width: 1180px) {
    .site-nav,
    .site-header-cta {
      display: none;
    }

    .mobile-nav-toggle {
      display: inline-flex;
    }
  }
</style>
