---
// src/pages/products.astro
import BaseLayout from "../layouts/BaseLayout.astro";
import Card from "../components/Card.astro";
import Button from "../components/Button.astro";
import { brand, futurePortfolio, industries3StoneOne } from "../config/brand";

const features = [
  "Three workflows: Analyze My Pick, Find a Pick, Build My Parlay",
  "Overall rating, verdict, and AI confidence score",
  "Biggest edge and biggest risk called out visually",
  "Color-coded findings (positive / negative / neutral)",
  "Mock service layer designed to swap in real APIs without a UI rewrite",
];

const results = [
  "Fully designed, built, and deployed to production",
  "Demonstrates the complete discovery-to-deployment process used for client work",
  "A live, working product - not a mockup or a prototype",
];

const oneFeatures = [
  "Seventeen modules - CRM, Projects, Inventory, Finance, Communications, Automation, and more, in one command center",
  "AI built into every module, not one chatbot page",
  "Relabels instantly for 7 industries - construction, restaurant, law firm, security, event center, medical, property management",
  "A visual workflow builder, a custom report builder, and a real Client Portal preview",
  "One shared data model and service layer, so a real backend can be swapped in without a UI rewrite",
];

const oneResults = [
  "Seventeen fully interactive modules, populated with realistic data - no placeholder screens",
  "Demonstrates the same industry-adaptive architecture 3Stone AI would build for a multi-location or multi-vertical business",
  "A live, working product - not a mockup or a prototype",
];

const counselFeatures = [
  "Ten areas - bankruptcy, property tax appeal, insurance claims, small claims, home buying, probate, taxes, business formation, permits, benefits",
  "Intake, eligibility screening, and personalized options with reasoning for every area",
  "Step-by-step guided workflows with document organization and deadline tracking",
  "Every trust moment closes with a clear disclosure - this is self-guided prep, not a licensed professional service",
];

const counselResults = [
  "Built and tested end to end across all ten areas",
  "One reusable guidance engine, presented externally as ten focused solutions",
  "In final development - billing, an admin console, and a lawyer-reviewed legal pass are next before public launch",
];
---

<BaseLayout
  title="Products"
  description="Explore 3Stone One and 3Stone Picks, two live 3Stone AI products, plus 3Stone Counsel, launching soon."
>
  <section class="page-hero">
    <div class="container section-narrow">
      <span class="eyebrow">Products</span>
      <h1>Proof, not promises</h1>
      <p>
        3Stone One and 3Stone Picks solve different problems with the same
        standard: understand the decision, design a clean system, and ship
        something genuinely useful. 3Stone Counsel is next.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <Card class="case-study">
        <span class="portfolio-project-badge">Innovation Lab</span>

        <div class="case-study-grid">
          <div class="case-study-screenshots">
            <img
              src="/images/betai-screenshot.webp"
              alt="3Stone Picks desktop view showing an overall rating, pick verdict, AI confidence score, and biggest edge and risk callouts"
              class="case-study-image desktop-shot"
              loading="lazy"
              width="1280"
              height="1488"
            />
            <img
              src="/images/betai-screenshot-mobile.webp"
              alt="3Stone Picks mobile view showing the same analysis, responsive to phone screens"
              class="case-study-image mobile-shot"
              loading="lazy"
              width="668"
              height="1280"
            />
          </div>

          <div class="case-study-body">
            <h2 class="card-title">3Stone Picks</h2>
            <p class="card-body">
              An AI sports betting analyst - not a chatbot. It rates a bet, gives
              a clear verdict (Bet / Lean / Pass / Avoid), and explains exactly
              why with a leg-by-leg breakdown.
            </p>

            <div class="case-study-block">
              <span class="block-label">The Problem</span>
              <p class="card-body">
                Bettors get flooded with opinions and no structured way to
                evaluate a bet. 3Stone Picks turns scattered signals - injuries, form,
                line movement - into one clear, explained recommendation.
              </p>
            </div>

            <div class="case-study-block">
              <span class="block-label">The Solution</span>
              <p class="card-body">
                A unified analysis engine powers all three workflows - Analyze
                My Bet, Find a Bet, Build My Parlay - so every recommendation
                is scored and explained the same consistent way, no matter how
                the user starts.
              </p>
            </div>

            <div class="case-study-block">
              <span class="block-label">Architecture</span>
              <p class="card-body">
                One shared data model (Finding, BetLeg, BetSlipAnalysis) and a
                single service layer sit behind all three workflows. The mock
                service implements a stable interface, so a real sports-data
                and AI backend can be swapped in later without touching the
                UI.
              </p>
            </div>

            <div class="case-study-block">
              <span class="block-label">Technologies</span>
              <ul class="tech-tags">
                <li>React</li>
                <li>TypeScript</li>
                <li>Vite</li>
                <li>Service-layer architecture</li>
              </ul>
            </div>

            <div class="case-study-ctas">
              <Button href="/3stone-picks" variant="primary">View Product</Button>
              <Button href={brand.githubUrl} variant="secondary">GitHub</Button>
            </div>
          </div>
        </div>

        <div class="case-study-extra">
          <div class="case-study-block">
            <span class="block-label">Features</span>
            <ul class="check-list">
              {features.map((item) => <li>{item}</li>)}
            </ul>
          </div>
          <div class="case-study-block">
            <span class="block-label">Results</span>
            <ul class="check-list">
              {results.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        </div>
      </Card>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <Card class="case-study">
        <span class="portfolio-project-badge flagship-badge">Flagship Product</span>

        <div class="case-study-grid stacked">
          <img
            src="/images/3stone-one-screenshot.webp"
            alt="3Stone One executive dashboard showing a morning briefing, a Business Health score, and revenue charts for Acme Construction"
            class="case-study-image wide-image"
            loading="lazy"
            width="1600"
            height="1000"
          />

          <div class="case-study-body">
            <h2 class="card-title">3Stone One</h2>
            <p class="card-body">
              The operating system for a business - CRM, projects, finance, communications, and your
              team, in one command center, with AI built into every module instead of one chatbot page.
            </p>

            <div class="case-study-block">
              <span class="block-label">The Problem</span>
              <p class="card-body">
                Business owners run their company across a dozen disconnected tools, with no single
                place to see what needs attention today, what's making or costing money, and who's
                behind on work.
              </p>
            </div>

            <div class="case-study-block">
              <span class="block-label">The Solution</span>
              <p class="card-body">
                One command center that sits on top of the tools a business already uses, not a
                replacement for them - with a morning briefing, an AI action in every module, and a
                Business Health score that answers "how are we doing?" in one number.
              </p>
            </div>

            <div class="case-study-block">
              <span class="block-label">Architecture</span>
              <p class="card-body">
                A single Industry Profile mechanism relabels every screen for the business behind it -
                {industries3StoneOne.slice(0, 3).join(", ")}, and four more - without branching the
                underlying code. The same service-layer pattern behind 3Stone Picks powers this at sixteen
                modules' scale.
              </p>
            </div>

            <div class="case-study-block">
              <span class="block-label">Technologies</span>
              <ul class="tech-tags">
                <li>Next.js</li>
                <li>TypeScript</li>
                <li>Recharts</li>
                <li>Service-layer architecture</li>
              </ul>
            </div>

            <div class="case-study-ctas">
              <Button href={brand.threeStoneOneDemoUrl} variant="primary">Live Demo</Button>
              <Button href={brand.threeStoneOneGithubUrl} variant="secondary">GitHub</Button>
              <Button href="/3stone-one" variant="ghost">Learn more →</Button>
            </div>
          </div>
        </div>

        <div class="case-study-extra">
          <div class="case-study-block">
            <span class="block-label">Features</span>
            <ul class="check-list">
              {oneFeatures.map((item) => <li>{item}</li>)}
            </ul>
          </div>
          <div class="case-study-block">
            <span class="block-label">Results</span>
            <ul class="check-list">
              {oneResults.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        </div>
      </Card>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <Card class="case-study">
        <span class="portfolio-project-badge coming-soon-project-badge">Coming Soon</span>

        <div class="case-study-grid">
          <div class="case-study-screenshots">
            <img
              src="/images/counsel-screenshot.webp"
              alt="3Stone Counsel case workspace showing a screening result and personalized options with benefits and drawbacks"
              class="case-study-image desktop-shot"
              loading="lazy"
              width="1280"
              height="1600"
            />
            <img
              src="/images/counsel-screenshot-mobile.webp"
              alt="3Stone Counsel mobile view showing the same case workspace, responsive to phone screens"
              class="case-study-image mobile-shot"
              loading="lazy"
              width="800"
              height="1800"
            />
          </div>

          <div class="case-study-body">
            <h2 class="card-title">3Stone Counsel</h2>
            <p class="card-body">
              A self-guided legal, financial, and administrative prep platform - not a chatbot.
              It screens your situation, lays out real options with the reasoning behind them,
              and walks you through the path you pick. Currently in final development.
            </p>

            <div class="case-study-block">
              <span class="block-label">The Problem</span>
              <p class="card-body">
                People pay thousands of dollars for legal and administrative processes - filing
                for bankruptcy, appealing a property tax assessment, fighting a denied insurance
                claim - that they could confidently handle themselves with the right guidance.
              </p>
            </div>

            <div class="case-study-block">
              <span class="block-label">The Solution</span>
              <p class="card-body">
                One reusable guidance engine - intake, eligibility screening, personalized
                options, step-by-step workflow - presented externally as ten focused, single-purpose
                solutions. Pick "Bankruptcy" for bankruptcy help, "Property Tax Appeal" for housing
                help, and get an experience built specifically for that situation.
              </p>
            </div>

            <div class="case-study-block">
              <span class="block-label">Architecture</span>
              <p class="card-body">
                Area-specificity lives entirely in prompts and curated step content, not the
                schema - the same case data model and AI resilience layer serve all ten areas, so
                adding an eleventh area means new content, not a rebuild.
              </p>
            </div>

            <div class="case-study-block">
              <span class="block-label">Technologies</span>
              <ul class="tech-tags">
                <li>React</li>
                <li>TypeScript</li>
                <li>Vite</li>
                <li>Supabase</li>
                <li>Claude</li>
              </ul>
            </div>

            <div class="case-study-ctas">
              <Button variant="secondary">Coming Soon</Button>
            </div>
          </div>
        </div>

        <div class="case-study-extra">
          <div class="case-study-block">
            <span class="block-label">Features</span>
            <ul class="check-list">
              {counselFeatures.map((item) => <li>{item}</li>)}
            </ul>
          </div>
          <div class="case-study-block">
            <span class="block-label">Results</span>
            <ul class="check-list">
              {counselResults.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        </div>
      </Card>
    </div>
  </section>

  {futurePortfolio.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-header">
          <span class="eyebrow">What&apos;s Next</span>
          <h2>More products, coming soon</h2>
        </div>
        <div class="future-grid">
          {futurePortfolio.map((item) => (
            <Card class="coming-soon-card">
              <span class="coming-soon-badge">Coming Soon</span>
              <h3 class="card-title">{item.name}</h3>
              <p class="card-body">{item.detail}</p>
            </Card>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .page-hero {
    padding: var(--space-3xl) 0 var(--space-2xl);
  }

  .page-hero .eyebrow {
    display: block;
    margin-bottom: var(--space-md);
  }

  h1 {
    font-family: var(--font-display);
    font-size: clamp(32px, 5vw, 52px);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -1.2px;
    margin: 0 0 var(--space-lg);
  }

  .page-hero p {
    font-size: 17px;
    line-height: 1.7;
    color: var(--text-secondary);
    max-width: 620px;
  }

  .section {
    padding: var(--space-xl) 0 var(--space-2xl);
    border-top: 1px solid var(--border-subtle);
  }

  .section-header {
    text-align: center;
    margin: 0 auto var(--space-xl);
  }

  h2 {
    font-family: var(--font-display);
    font-size: clamp(24px, 3.5vw, 32px);
    font-weight: 700;
    letter-spacing: -0.6px;
    margin: 0;
  }

  .portfolio-project-badge {
    display: inline-block;
    font-family: var(--font-label);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.5px;
    color: var(--accent-primary);
    background: var(--accent-primary-dim);
    border: 1px solid rgba(110, 147, 214, 0.28);
    padding: 4px 10px;
    border-radius: 999px;
    margin-bottom: var(--space-lg);
  }

  .flagship-badge {
    color: var(--bg-base);
    background: var(--accent-primary);
    border-color: var(--accent-primary);
  }

  .coming-soon-project-badge {
    color: var(--text-secondary);
    background: var(--bg-surface-raised);
    border-color: var(--border-subtle);
  }

  .case-study-ctas :global(button.btn) {
    cursor: default;
    opacity: 0.7;
  }

  .case-study-ctas :global(button.btn:hover) {
    transform: none;
  }

  .case-study-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl);
    align-items: start;
  }

  @media (max-width: 800px) {
    .case-study-grid {
      grid-template-columns: 1fr;
    }
  }

  .case-study-grid.stacked {
    grid-template-columns: 1fr;
    gap: var(--space-lg);
  }

  .wide-image {
    width: 100%;
    height: auto;
  }

  .case-study-screenshots {
    display: flex;
    gap: var(--space-md);
    align-items: flex-start;
  }

  .case-study-image {
    border-radius: var(--radius-md);
    border: 1px solid var(--border-subtle);
  }

  .desktop-shot {
    width: 68%;
    height: auto;
  }

  .mobile-shot {
    width: 32%;
    height: auto;
  }

  @media (max-width: 500px) {
    .case-study-screenshots {
      flex-direction: column;
    }

    .desktop-shot,
    .mobile-shot {
      width: 100%;
    }
  }

  .card-title {
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 700;
    letter-spacing: -0.4px;
    margin: 0 0 var(--space-sm);
  }

  .card-body {
    font-size: 15px;
    line-height: 1.65;
    color: var(--text-secondary);
    margin: 0;
  }

  .case-study-block {
    margin-top: var(--space-lg);
  }

  .block-label {
    display: block;
    font-family: var(--font-label);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.5px;
    color: var(--text-tertiary);
    margin-bottom: 8px;
  }

  .tech-tags {
    display: flex;
    gap: 8px;
    list-style: none;
    margin: var(--space-sm) 0 0;
    padding: 0;
    flex-wrap: wrap;
  }

  .tech-tags li {
    font-family: var(--font-label);
    font-size: 12px;
    font-weight: 500;
    color: var(--text-secondary);
    background: var(--bg-surface-raised);
    border: 1px solid var(--border-subtle);
    padding: 5px 12px;
    border-radius: 999px;
  }

  .case-study-ctas {
    display: flex;
    gap: var(--space-sm);
    margin-top: var(--space-lg);
    flex-wrap: wrap;
  }

  .case-study-extra {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl);
    margin-top: var(--space-xl);
    padding-top: var(--space-xl);
    border-top: 1px solid var(--border-subtle);
  }

  @media (max-width: 600px) {
    .case-study-extra {
      grid-template-columns: 1fr;
    }
  }

  .case-study-extra .case-study-block {
    margin-top: 0;
  }

  .check-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .check-list li {
    position: relative;
    padding-left: 24px;
    font-size: 14px;
    line-height: 1.5;
    color: var(--text-secondary);
  }

  .check-list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 7px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent-primary);
  }

  .future-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 320px));
    justify-content: center;
    gap: var(--space-lg);
  }

  .coming-soon-card {
    opacity: 0.6;
  }

  .coming-soon-badge {
    display: inline-block;
    font-family: var(--font-label);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.5px;
    color: var(--text-secondary);
    background: var(--bg-surface-raised);
    border: 1px solid var(--border-subtle);
    padding: 4px 10px;
    border-radius: 999px;
    margin-bottom: var(--space-sm);
  }
</style>
