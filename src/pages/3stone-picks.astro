---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import Card from "../components/Card.astro";
import { brand } from "../config/brand";

const workflows = [
  {
    title: "Analyze My Pick",
    detail: "Bring a wager you are considering and get a structured rating, verdict, confidence level, and explanation.",
  },
  {
    title: "Find a Pick",
    detail: "Start with a sport or matchup and use the same analysis framework to surface the strongest opportunity.",
  },
  {
    title: "Build My Parlay",
    detail: "Evaluate each leg together so the biggest edge, biggest risk, and combined profile stay clear.",
  },
];
---

<BaseLayout
  title="3Stone Picks"
  description="3Stone Picks is 3Stone AI's sports intelligence product, turning scattered betting signals into clear, structured analysis."
>
  <section class="page-hero">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="container section-narrow">
      <span class="eyebrow">Sports Intelligence · Formerly BetAI</span>
      <h1>3Stone Picks</h1>
      <p class="tagline">A clearer way to research every pick.</p>
      <p class="lede">
        3Stone Picks turns injuries, recent form, line movement, and matchup context into one
        structured view. You get a rating, a direct verdict, AI confidence, and the reasoning
        behind the biggest edge and biggest risk.
      </p>
      <div class="hero-ctas">
        <Button href={brand.threeStonePicksUrl} variant="primary">Open 3Stone Picks</Button>
        <Button href="/products" variant="secondary">View All Products</Button>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="product-preview">
        <img
          src="/images/betai-screenshot.webp"
          alt="3Stone Picks analysis showing an overall rating, AI confidence, and biggest edge and risk"
          class="product-image"
          width="1280"
          height="1488"
        />
        <div>
          <span class="eyebrow">How It Works</span>
          <h2>One analysis standard, however you start.</h2>
          <p>
            Every workflow uses the same underlying model, so recommendations stay consistent
            whether you bring your own pick, look for an opportunity, or build a parlay.
          </p>
          <div class="workflow-list">
            {workflows.map((workflow) => (
              <Card class="workflow-card">
                <h3>{workflow.title}</h3>
                <p>{workflow.detail}</p>
              </Card>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container section-narrow closing">
      <span class="eyebrow">Built by 3Stone AI</span>
      <h2>Decision support, not unexplained picks.</h2>
      <p>
        The point is not to flood you with another opinion. It is to organize the signals that
        matter and show why a pick looks strong, weak, or too uncertain to force.
      </p>
      <Button href={brand.threeStonePicksUrl} variant="primary">Try 3Stone Picks</Button>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    position: relative;
    padding: var(--space-3xl) 0 var(--space-2xl);
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(circle at 28% 18%, rgba(110, 147, 214, 0.14), transparent 46%);
  }

  .eyebrow {
    display: block;
    margin-bottom: var(--space-md);
    color: var(--accent-primary);
    font-family: var(--font-label);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }

  h1 {
    margin: 0 0 var(--space-sm);
    font-family: var(--font-display);
    font-size: clamp(38px, 6vw, 64px);
    letter-spacing: -1.4px;
  }

  .tagline {
    margin: 0 0 var(--space-lg);
    color: var(--text-primary);
    font-size: 21px;
    font-weight: 500;
  }

  .lede,
  .section p {
    color: var(--text-secondary);
    font-size: 16px;
    line-height: 1.7;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-top: var(--space-xl);
  }

  .section {
    padding: var(--space-2xl) 0;
    border-top: 1px solid var(--border-subtle);
  }

  h2 {
    margin: 0 0 var(--space-md);
    font-family: var(--font-display);
    font-size: clamp(26px, 4vw, 38px);
    letter-spacing: -0.7px;
  }

  .product-preview {
    display: grid;
    grid-template-columns: minmax(280px, 0.8fr) minmax(0, 1.2fr);
    gap: var(--space-2xl);
    align-items: start;
  }

  .product-image {
    width: 100%;
    height: auto;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
  }

  .workflow-list {
    display: grid;
    gap: var(--space-md);
    margin-top: var(--space-xl);
  }

  :global(.workflow-card) {
    padding: var(--space-lg);
  }

  :global(.workflow-card h3) {
    margin: 0 0 6px;
    font-size: 17px;
  }

  :global(.workflow-card p) {
    margin: 0;
    font-size: 14px;
  }

  .closing :global(.btn) {
    margin-top: var(--space-md);
  }

  @media (max-width: 760px) {
    .product-preview {
      grid-template-columns: 1fr;
    }

    .product-image {
      max-width: 440px;
    }

    .hero-ctas {
      flex-direction: column;
    }

    .hero-ctas :global(.btn) {
      width: 100%;
    }
  }
</style>
